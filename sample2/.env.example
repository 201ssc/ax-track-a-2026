# 습관 다이어리 환경 설정 예시 — 실제 API 키는 이 파일에 넣지 않는다.
# 저장소 루트에서 최초 한 번: cp -n sample2/.env.example sample2/.env
# 이후 값은 sample2/.env에서 수정한다. .env는 Git 제외, 이 예시만 공유한다.
# 설정을 바꾼 뒤 서버를 재시작한다. 이미 설정된 프로세스 환경값이 우선한다.

# ── 1. 현재 서버/CLI에서 사용하는 설정 ──
# 로컬 서버 포트. 접속: http://localhost:8787/sample2/
PORT=8787

# DB 절대 경로. 비우면 OS 사용자 데이터 디렉터리를 사용한다.
# Linux 기본: ~/.local/share/iruo-habit-diary/diary.sqlite
# 예: DIARY_DB_PATH=/home/사용자명/diary-data/diary.sqlite
DIARY_DB_PATH=

# ── 2. 실제 Gemini 호출 설정 (서버에서만 사용) ──
# 참고한 원본 설정: https://github.com/2026-ai-service-engineering-a/account-book/tree/c741b8cfaa424ad2714988b1725aaff44c5eb4c6
# Gemini만 사용한다. 실제 키는 .env의 GEMINI_API_KEY에 넣는다.
GEMINI_API_KEY=

# 첫 테스트의 권장 기본값. gemini/는 앱에서 사용할 제공자 구분 접두사다.
# Google API에 전달할 실제 모델 ID는 gemini-3.5-flash-lite다.
# 공식 문서: https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash-lite
AGENT_MODEL=gemini/gemini-3.5-flash-lite

# AI 호출 1회의 제한 시간(초), 1~30 허용. 자동 재시도는 하지 않는다.
AGENT_TIMEOUT_SECONDS=10

# 키와 모델을 채우고 재시작하면 루틴 추가·삭제 해석에 실제 Gemini를 사용한다.
# 둘 다 비우면 각본 대역으로 실행한다. 하나만 있으면 설정 오류로 시작을 중단한다.
# 일정·목차·숫자 조회는 기존 각본 기능으로 유지한다. 변경 저장은 사용자 확인 후에만 한다.
# 현재 날짜 기준은 Asia/Seoul 고정이다. USER_TIMEZONE 변경 기능은 아직 없다.
